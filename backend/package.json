{
  "name": "jm-sistemas-backend",
  "version": "1.0.0",
  "description": "Servidor Express em Nuvem Multi-Tenant por CNPJ - JM Sistemas",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
